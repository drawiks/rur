pkgname=htop
pkgver=3.3.0
pkgrel=1
pkgdesc="Interactive process viewer"
url="https://htop.dev"
license=('GPL-2.0-only')
arch=('x86_64')
depends=('musl' 'ncurses')
makedepends=('make' 'gcc' 'ncurses')

source=("https://github.com/htop-dev/htop/releases/download/${pkgver}/htop-${pkgver}.tar.xz")
sha256sums=('a69acf9b42ff592c4861010fce7d8006805f0d6ef0e8ee647a6ee6e59b743d5c')

build() {
    cd "${srcdir}/htop-${pkgver}"
    ./configure \
        --prefix=/usr \
        --disable-unicode \
        --disable-hwloc \
        --disable-capabilities \
        --disable-delayacct
    make
}

package() {
    cd "${srcdir}/htop-${pkgver}"
    make DESTDIR="${pkgdir}" install
}
