pkgname=strace
pkgver=6.13
pkgrel=1
pkgdesc="Debugging tool to trace system calls and signals"
url="https://strace.io"
license=('LGPL-2.1-or-later')
arch=('x86_64')
depends=('musl')
makedepends=('make' 'gcc' 'musl')

source=("https://github.com/strace/strace/releases/download/v${pkgver}/strace-${pkgver}.tar.xz")
sha256sums=('e209daf0ee038ca5adcc4c277e9273b4d51f46a2ff86da575d36742ac3508a17')

build() {
    cd "${srcdir}/strace-${pkgver}"
    ./configure \
        --prefix=/usr \
        --enable-mpers=no
    make
}

package() {
    cd "${srcdir}/strace-${pkgver}"
    make DESTDIR="${pkgdir}" install
}
