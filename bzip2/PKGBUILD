pkgname=bzip2
pkgver=1.0.8
pkgrel=1
pkgdesc="A block-sorting file compressor"
url="https://sourceware.org/bzip2"
license=('bzip2-1.0.6')
arch=('x86_64')
depends=('musl')
makedepends=('make')

source=("https://sourceware.org/pub/bzip2/bzip2-${pkgver}.tar.gz")
sha256sums=('ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269')

build() {
    cd "${srcdir}/bzip2-${pkgver}"
    make -f Makefile-libbz2_so CFLAGS="-O2 -fPIC" PREFIX=/usr
    make CFLAGS="-O2" PREFIX=/usr
}

package() {
    cd "${srcdir}/bzip2-${pkgver}"
    make PREFIX="${pkgdir}/usr" install
    rm -f "${pkgdir}/usr/lib/libbz2.a"
}
