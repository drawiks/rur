pkgname=libunistring
pkgver=1.4.2
pkgrel=1
pkgdesc="Library for manipulating Unicode strings and C strings"
url="https://www.gnu.org/software/libunistring/"
license=('LGPL-3.0-or-later')
arch=('x86_64')
depends=('musl')
makedepends=('make' 'gcc')

source=("https://ftp.gnu.org/gnu/libunistring/libunistring-${pkgver}.tar.gz")
sha256sums=('e82664b170064e62331962126b259d452d53b227bb4a93ab20040d846fec01d8')

build() {
    cd "${srcdir}/libunistring-${pkgver}"
    ./configure \
        --prefix=/usr \
        --disable-static \
        --disable-rpath
    make -j"${nproc}"
}

package() {
    cd "${srcdir}/libunistring-${pkgver}"
    make DESTDIR="${pkgdir}" install
    rm -f "${pkgdir}/usr/lib/libunistring.a"
}