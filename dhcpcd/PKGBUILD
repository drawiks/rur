pkgname=dhcpcd
pkgver=10.5.2
pkgrel=1
pkgdesc="A client for IPv4/IPv6 DHCP and DHCPv6"
url="https://roy.marples.name/projects/dhcpcd"
license=('BSD-2-Clause')
arch=('x86_64')
depends=('musl')
makedepends=('make' 'gcc')

source=("https://github.com/NetworkConfiguration/dhcpcd/releases/download/v${pkgver}/dhcpcd-${pkgver}.tar.xz")
sha256sums=('3e476657fdb6eeb38b277da3a48d0ac0113ecce5858ebdcddff2b629faed52b4')

build() {
    cd "${srcdir}/dhcpcd-${pkgver}"
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --dbus=no \
        --disable-privsep \
        --without-udev
    make -j"${nproc}"
}

package() {
    cd "${srcdir}/dhcpcd-${pkgver}"
    make DESTDIR="${pkgdir}" install
}
