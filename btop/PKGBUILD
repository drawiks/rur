pkgname=btop
pkgver=1.4.0
pkgrel=1
pkgdesc="A monitor of resources (CPU, memory, disks, network, processes)"
url="https://github.com/aristocratos/btop"
license=('Apache-2.0')
arch=('x86_64')
depends=('musl' 'gcc' 'libstdc++' 'ncurses')
makedepends=('make' 'gcc')

source=("https://github.com/aristocratos/btop/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('ac0d2371bf69d5136de7e9470c6fb286cbee2e16b4c7a6d2cd48a14796e86650')

build() {
    cd "${srcdir}/btop-${pkgver}"
    make PREFIX=/usr STATIC=true
}

package() {
    cd "${srcdir}/btop-${pkgver}"
    make PREFIX="${pkgdir}/usr" install
}
