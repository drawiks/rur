pkgname=yazi
pkgver=25.2.26
pkgrel=1
pkgdesc="Blazing fast terminal file manager"
url="https://yazi-rs.github.io/"
license=('MIT')
arch=('x86_64')
depends=('musl' 'rust')
makedepends=()

source=("https://github.com/sxyazi/yazi/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('49e1a0fb4e8b4c14c1e16e4b4c9bc52302a5ea7104605f3408c3ab513c3a4869')

build() {
    cd "${srcdir}/yazi-${pkgver}"
    cargo build --release
}

package() {
    cd "${srcdir}/yazi-${pkgver}"
    install -Dm755 target/release/yazi "${pkgdir}/usr/bin/yazi"
    install -Dm755 target/release/ya "${pkgdir}/usr/bin/ya"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/yazi/LICENSE"
}
