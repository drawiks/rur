pkgname=zsh
pkgver=5.9.2
pkgrel=1
pkgdesc="A very advanced and programmable command interpreter (shell)"
url="https://www.zsh.org/"
license=('MIT-Modern-Variant')
arch=('x86_64')
depends=('musl')
makedepends=('make' 'gcc')

source=("https://www.zsh.org/pub/zsh-${pkgver}.tar.xz")
sha256sums=('36fa734374b44783582cec09bcd67822e2f992c779ec1624ab5596df078d2f81')

build() {
    cd "${srcdir}/zsh-${pkgver}"
    ./configure \
        --prefix=/usr \
        --disable-dynamic
    make -j"${nproc}"
}

package() {
    cd "${srcdir}/zsh-${pkgver}"
    make DESTDIR="${pkgdir}" install
}
