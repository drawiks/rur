pkgname=nmap
pkgver=7.95
pkgrel=1
pkgdesc="Utility for network discovery and security auditing"
url="https://nmap.org/"
license=('NPSL')
arch=('x86_64')
depends=('musl' 'openssl')
makedepends=('make' 'gcc')

source=("https://nmap.org/dist/nmap-${pkgver}.tar.bz2")
sha256sums=('e14ab530e47b5afd88f1c8a2bac7f89cd8fe6b478e22d255c5b9bddb7a1c5778')

build() {
    cd "${srcdir}/nmap-${pkgver}"
    ./configure \
        --prefix=/usr \
        --without-zenmap \
        --without-nmap-update
    make
}

package() {
    cd "${srcdir}/nmap-${pkgver}"
    make DESTDIR="${pkgdir}" install
}
