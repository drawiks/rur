pkgname=tree
pkgver=2.1.1
pkgrel=1
pkgdesc="A directory listing program displaying a depth indented list of files"
url="https://oldmanprogrammer.net/source.php?dir=projects/tree"
license=('GPL-2.0-only')
arch=('x86_64')
depends=('musl')
makedepends=('make' 'gcc')

source=("https://github.com/Old-Man-Programmer/tree/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('1b70253994dca48a59d6ed99390132f4d55c486bf0658468f8520e7e63666a06')

build() {
    cd "${srcdir}/tree-${pkgver}"
    make PREFIX=/usr
}

package() {
    cd "${srcdir}/tree-${pkgver}"
    make PREFIX="${pkgdir}/usr" install
}
