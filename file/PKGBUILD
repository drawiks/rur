pkgname=file
pkgver=5.46
pkgrel=1
pkgdesc="File type identification utility"
url="https://www.darwinsys.com/file/"
license=('BSD-2-Clause')
arch=('x86_64')
depends=('musl' 'zlib')
makedepends=('make' 'gcc')

source=("https://astron.com/pub/file/file-${pkgver}.tar.gz")
sha256sums=('c9cc77c7c560c543135edc555af609d5619dbef011997e988ce40a3d75d86088')

build() {
    cd "${srcdir}/file-${pkgver}"
    ./configure \
        --prefix=/usr \
        --disable-static \
        --disable-libseccomp
    make
}

package() {
    cd "${srcdir}/file-${pkgver}"
    make DESTDIR="${pkgdir}" install
    rm -f "${pkgdir}/usr/lib/libmagic.a" "${pkgdir}/usr/lib/libmagic.la"
}
