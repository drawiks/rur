pkgname=e2fsprogs
pkgver=1.47.4
pkgrel=1
pkgdesc="Ext2/3/4 filesystem utilities"
url="https://e2fsprogs.sourceforge.net/"
license=('GPL-2.0-or-later')
arch=('x86_64')
depends=('musl')
makedepends=('make' 'gcc')

source=("https://mirrors.edge.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v${pkgver}/e2fsprogs-${pkgver}.tar.gz")
sha256sums=('da274408bebbfd13a5a2fc3cfc66e3ffff17c48534673aa67f88d49b99123b96')

build() {
    cd "${srcdir}/e2fsprogs-${pkgver}"
    ./configure \
        --prefix=/usr \
        --disable-defrag \
        --disable-fuse2fs \
        --disable-libblkid \
        --disable-libuuid \
        --disable-nls \
        --disable-uuidd
    make -j"${nproc}"
}

package() {
    cd "${srcdir}/e2fsprogs-${pkgver}"
    make DESTDIR="${pkgdir}" install
    install -d -m 0755 "${pkgdir}/etc"
}
